{
  "expo": {
    "name": "Calculator",
    "owner": "momroojs-team",
    "slug": "magical-calculator",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "magical-calculator",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": false
    },
    "android": {
      "package": "com.mufasels.magicalcalculator",
      "resizeableActivity": true,
      "windowSoftInputMode": "adjustResize"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "resizeMode": "cover"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "4ea7276a-b333-4d4c-872e-85d9011d531c"
      }
    }
  }
}
